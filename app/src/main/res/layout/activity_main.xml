<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <RelativeLayout
        android:id="@+id/preview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_container">
        
        <TextureView
            android:id="@+id/view_finder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true" />
            
        <View
            android:id="@+id/focus_ring"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/focus_frame"
            android:visibility="gone" />
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:paddingTop="32dp"
        android:paddingHorizontal="24dp">
        
        <ImageView
            android:id="@+id/btn_flash"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentStart="true"
            android:src="@drawable/ic_flash_off"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btn_ratio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="4:3"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="4" />

        <ImageView
            android:id="@+id/btn_settings"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:src="@drawable/more_vert_24px"
            android:tint="#FFFFFF"
            android:clickable="true"
            android:focusable="true"/>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#FF000000"
        android:gravity="center"
        android:paddingTop="12dp">

        <LinearLayout
            android:id="@+id/slider_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_marginHorizontal="32dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/btn_auto_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#00FF00"
                android:textSize="14sp"
                android:paddingEnd="16dp"
                android:text="AUTO"
                android:gravity="center"
                android:fontFamily="sans-serif-medium"/>

            <SeekBar
                android:id="@+id/setting_seekbar"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:max="100"
                android:splitTrack="false"
                android:progressDrawable="@android:color/transparent"
                android:tickMark="@drawable/tick_mark"
                android:thumb="@drawable/ruler_thumb"
                android:minHeight="24dp"
                android:maxHeight="24dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="5"
            android:gravity="center"
            android:paddingBottom="12dp">

            <TextView android:id="@+id/btn_af" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="AF\n-" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" android:textAlignment="center" android:padding="8dp" android:fontFamily="sans-serif"/>
            <TextView android:id="@+id/btn_iso" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ISO\n-" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" android:textAlignment="center" android:padding="8dp" android:fontFamily="sans-serif"/>
            <TextView android:id="@+id/btn_wb" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="WB\nAUTO" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" android:textAlignment="center" android:padding="8dp" android:fontFamily="sans-serif"/>
            <TextView android:id="@+id/btn_s" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="S\n-" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" android:textAlignment="center" android:padding="8dp" android:fontFamily="sans-serif"/>
            <TextView android:id="@+id/btn_ev" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="EV\n0" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" android:textAlignment="center" android:padding="8dp" android:fontFamily="sans-serif"/>
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="100dp">

            <ImageView
                android:id="@+id/thumbnail_view"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:layout_marginStart="32dp"
                android:scaleType="centerCrop"
                android:background="#44FFFFFF"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/btn_capture"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_centerInParent="true"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/circle_button" />
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
