<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_pure">

    <TextureView
        android:id="@+id/view_finder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true" />

    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_alignParentTop="true"
        android:background="@drawable/bg_top_gradient" />

    <View
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_bottom_gradient" />

    <RelativeLayout
        android:id="@+id/focus_ring"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_centerInParent="true"
        android:background="@drawable/focus_frame"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="-22dp"
            android:background="@drawable/bg_auto_pill"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/focus_ev_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EV 0.0"
                android:textColor="@color/accent_yellow"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/slider_panel"
        android:layout_above="@+id/bottom_controls"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp"
        android:background="@drawable/bg_panel"
        android:visibility="gone">

        <TextView
            android:id="@+id/slider_value_title"
            style="@style/SliderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:text="ISO 100" />

        <com.procamera.RulerView
            android:id="@+id/setting_ruler"
            android:layout_width="match_parent"
            android:layout_height="56dp" />

        <ImageView
            android:id="@+id/btn_auto_toggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:padding="8dp"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="@string/cd_reset_auto"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_reset"
            android:tint="@color/accent_yellow" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="0dp"
        android:clickable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btn_flash"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="@string/cd_flash"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_flash_off"
            android:tint="@android:color/white" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_ratio"
            style="@style/TopBarText"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="64dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_pill_button"
            android:text="@string/ratio_16_9" />

        <ImageView
            android:id="@+id/btn_menu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:padding="10dp"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="@string/cd_menu"
            android:scaleType="fitCenter"
            android:src="@drawable/more_vert_24px"
            android:tint="@android:color/white" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingBottom="0dp"
        android:paddingTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:paddingTop="12dp">

            <TextView
                android:id="@+id/btn_af"
                style="@style/ModeButtonText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="AF\nAUTO" />

            <TextView
                android:id="@+id/btn_iso"
                style="@style/ModeButtonText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="ISO\nAUTO" />

            <TextView
                android:id="@+id/btn_wb"
                style="@style/ModeButtonText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="WB\nAUTO" />

            <TextView
                android:id="@+id/btn_s"
                style="@style/ModeButtonText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="S\nAUTO" />

            <TextView
                android:id="@+id/btn_ev"
                style="@style/ModeButtonText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="EV\n0.0" />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="4dp">

            <ImageView
                android:id="@+id/thumbnail_view"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_thumbnail"
                android:clipToOutline="true"
                android:contentDescription="@string/cd_thumbnail" />

            <View
                android:id="@+id/btn_capture"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_centerInParent="true"
                android:background="@drawable/shutter_button"
                android:contentDescription="@string/cd_shutter" />

            <View
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:background="@android:color/transparent" />
        </RelativeLayout>
    </LinearLayout>

</RelativeLayout>
