<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center">
        
        <TextureView
            android:id="@+id/view_finder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </RelativeLayout>

    <TextView
        android:id="@+id/btn_ratio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32dp"
        android:background="@drawable/rounded_bg"
        android:paddingHorizontal="24dp"
        android:paddingVertical="10dp"
        android:text="3:4"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:elevation="4dp"/>

    <LinearLayout
        android:id="@+id/control_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_bar"
        android:orientation="vertical"
        android:background="#B3000000"
        android:paddingTop="8dp">

        <!-- แถบเลื่อนแบบมือถือเรือธง -->
        <LinearLayout
            android:id="@+id/slider_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/modern_panel_bg"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <!-- ปุ่ม AUTO ที่กดสลับได้ -->
            <TextView
                android:id="@+id/btn_auto_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFD700"
                android:textStyle="bold"
                android:textSize="14sp"
                android:padding="8dp"
                android:text="AUTO"/>

            <SeekBar
                android:id="@+id/setting_seekbar"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:max="100"
                android:splitTrack="false"
                android:progressDrawable="@android:drawable/progress_horizontal"
                android:thumbTint="#FFD700"
                android:progressTint="#FFD700"/>

            <!-- ตัวเลขแสดงค่าปัจจุบัน -->
            <TextView
                android:id="@+id/slider_value_text"
                android:layout_width="55dp"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textAlignment="viewEnd"
                android:text="AUTO"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="5"
            android:paddingBottom="16dp">

            <TextView android:id="@+id/btn_af" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="AF\nAUTO" android:textColor="#FFFFFF" android:textSize="12sp" android:textAlignment="center" android:padding="8dp"/>
            <TextView android:id="@+id/btn_iso" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ISO\nAUTO" android:textColor="#FFFFFF" android:textSize="12sp" android:textAlignment="center" android:padding="8dp"/>
            <TextView android:id="@+id/btn_wb" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="WB\nAWB" android:textColor="#FFFFFF" android:textSize="12sp" android:textAlignment="center" android:padding="8dp"/>
            <TextView android:id="@+id/btn_s" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="S\nAUTO" android:textColor="#FFFFFF" android:textSize="12sp" android:textAlignment="center" android:padding="8dp"/>
            <TextView android:id="@+id/btn_ev" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="EV\n0.0" android:textColor="#FFFFFF" android:textSize="12sp" android:textAlignment="center" android:padding="8dp"/>
        </LinearLayout>
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_alignParentBottom="true"
        android:background="#FF000000">

        <ImageView
            android:id="@+id/thumbnail_view"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="32dp"
            android:scaleType="centerCrop"
            android:background="#44FFFFFF"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/btn_capture"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_centerInParent="true"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/circle_button" />
    </RelativeLayout>
</RelativeLayout>
