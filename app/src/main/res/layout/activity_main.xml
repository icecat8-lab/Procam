<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <TextureView
        android:id="@+id/view_finder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    
    <LinearLayout
        android:id="@+id/control_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_bar"
        android:orientation="vertical"
        android:background="#88000000"
        android:paddingTop="8dp">

        
        <LinearLayout
            android:id="@+id/slider_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:padding="16dp">

            <TextView
                android:id="@+id/slider_value_text"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:textColor="#FFD700"
                android:textStyle="bold"
                android:textSize="14sp"
                android:text="AUTO"/>

            <SeekBar
                android:id="@+id/setting_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- ปุ่มเมนู 5 อย่าง -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="5"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/btn_af"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AF\nAUTO"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textAlignment="center"
                android:padding="8dp"/>

            <TextView
                android:id="@+id/btn_iso"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ISO\nAUTO"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textAlignment="center"
                android:padding="8dp"/>

            <TextView
                android:id="@+id/btn_wb"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WB\nAWB"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textAlignment="center"
                android:padding="8dp"/>

            <TextView
                android:id="@+id/btn_s"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="S\nAUTO"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textAlignment="center"
                android:padding="8dp"/>

            <TextView
                android:id="@+id/btn_ev"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="EV\n0"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textAlignment="center"
                android:padding="8dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- พื้นที่ด้านล่างสำหรับปุ่มชัตเตอร์และแกลเลอรี -->
    <RelativeLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"
        android:background="#FF000000">

        <ImageView
            android:id="@+id/thumbnail_view"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="24dp"
            android:scaleType="centerCrop"
            android:background="#44FFFFFF"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/btn_capture"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_centerInParent="true"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/circle_button" />
    </RelativeLayout>

</RelativeLayout>
