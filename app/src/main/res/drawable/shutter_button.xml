<?xml version="1.0" encoding="utf-8"?>
<!-- iOS-style shutter button: outer white ring + inner blue/white circle -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer ring (white) -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/white" />
            <size
                android:width="76dp"
                android:height="76dp" />
        </shape>
    </item>
    <!-- Inner circle (transparent cutout to give ring effect) -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/black_pure" />
        </shape>
    </item>
    <!-- Inner solid button -->
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/white" />
        </shape>
    </item>
</layer-list>
